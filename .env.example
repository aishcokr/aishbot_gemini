# .env.example — 이 파일을 복사해 `.env` 로 만든 뒤 값을 채우세요.
# .env 는 .gitignore에 등록되어 있어 커밋되지 않습니다.
#
# 로컬 테스트:  npx vercel dev
# 실제 배포:    Vercel 대시보드 → Settings → Environment Variables 에 등록
#
# 키 발급: https://aistudio.google.com/apikey  (무료 등급 사용 가능)

GEMINI_API_KEY=여기에_발급받은_키를_붙여넣으세요

# (선택) 사용할 모델. 비워두면 gemini-3.5-flash-lite 를 씁니다.
#
# 같은 질문으로 측정한 응답 시간:
#   gemini-3.5-flash-lite    1.4초   ← 기본값. 챗봇에는 이 정도 속도가 필요합니다
#   gemini-3.5-flash        16.8초
#   gemini-3.6-flash        35.0초   (추론을 꺼도 28초)
#
# 404 오류("no longer available to new users")가 나면 오류 메시지가 안내하는
# 모델명으로 바꾸거나, 절대 만료되지 않는 별칭 gemini-flash-lite-latest 를 쓰세요.
# GEMINI_MODEL=gemini-3.5-flash-lite

# (선택) widget.js 를 붙일 외부 사이트 목록. 쉼표로 구분하며 경로는 뺍니다.
# 여기 없는 도메인에서 호출하면 403으로 차단됩니다.
# 자기 자신(이 Vercel 도메인)은 등록하지 않아도 항상 허용됩니다.
ALLOWED_ORIGINS=https://aish.github.io/
